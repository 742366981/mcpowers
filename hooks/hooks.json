{
  "_mcpowers_marker": true,
  "_mcpowers_version": "1.1.0",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOOKS_DIR__/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOOKS_DIR__/pre-bash-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOOKS_DIR__/pre-write-confirm.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOOKS_DIR__/post-write-commit-reminder.sh\""
          }
        ]
      }
    ]
  }
}
