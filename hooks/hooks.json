{
  "_mcpowers_marker": true,
  "_mcpowers_version": "1.0.0",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOOKS_DIR__/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOOKS_DIR__/pre-bash-guard.sh\""
          }
        ]
      }
    ]
  }
}
